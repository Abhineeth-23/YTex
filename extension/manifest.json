{
  "manifest_version": 3,
  "name": "YT Smart Chapterizer",
  "version": "1.0",
  "description": "Generate topic-based YouTube chapters",

  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.onrender.com/*",
    "http://localhost/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }
}
